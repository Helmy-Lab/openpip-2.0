# Copy to .env and fill in. Every variable is described in
# docs/operator-guide/configuration.md.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-key-change-in-production
# Set before the first start; Postgres only reads it when the volume is created.
DB_PASSWORD=openpip_dev

# The address people reach your portal at, e.g. https://openpip.example.org
# or https://www.example.org/openpip. Leave empty to run it on this computer
# at http://localhost:8080.
PUBLIC_URL=
